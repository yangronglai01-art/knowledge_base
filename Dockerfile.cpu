# =============================================================
# 知犀 RAG 应用镜像 —— 纯 CPU 版
# 与 Dockerfile（GPU 版）并存，互不影响；GPU 版保持不变。
#
# 差异点：
# 1. 使用 pyproject.cpu.toml（torch 走 pytorch-cpu 源），构建时按 CPU 源
#    重新解析并生成 CPU 版 uv.lock（因此这里不使用 --frozen）。
# 2. 默认 BGE_DEVICE=cpu、BGE_FP16=false（纯 CPU 推理）。
# 3. 镜像体积明显小于 GPU 版（约 2-3GB vs 6-8GB）。
#
# 用法：docker compose -f docker-compose.yml -f docker-compose.cpu.yml up -d --build
# =============================================================

FROM python:3.11-slim-bookworm

# 系统依赖：curl(健康检查/下载)、ca-certificates(HTTPS)、libgomp1(torch CPU 的 OpenMP 运行时)
# 说明：本项目依赖全部是预编译 wheel，无需编译工具链，故不装 git/build-essential，
#       既减小镜像体积，又大幅降低 apt 拉包量（避免国内网络下 apt 频繁 502）。
# 国内网络：apt 源切到阿里云镜像并改用 HTTPS（国内 HTTP 80 端口常被劫持导致 502；
#           实测容器内仅 aliyun/tencent 的 HTTPS 可达，tuna/ustc/huawei/163 均 TLS 中断）
RUN sed -i 's|http://deb.debian.org|https://mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --no-install-recommends -o Acquire::Retries=10 -o Acquire::http::Timeout=60 \
        curl ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 安装 uv（生产环境建议固定版本号，如 ghcr.io/astral-sh/uv:0.12.5）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 用 CPU 版依赖清单替换项目清单（不复制 GPU 版 uv.lock，构建时重新解析生成 CPU lock）
COPY pyproject.cpu.toml pyproject.toml
RUN uv sync --no-dev

# 复制应用源码（不含 .env，凭据由 docker-compose env_file 注入）
COPY knowledge_base ./knowledge_base
COPY scripts ./scripts
COPY tests ./tests

# 模型权重与上传数据通过挂载卷提供，不打进镜像
ENV BGE_M3_PATH=/models/bge-m3 \
    DATA_BASED_ROOT_DIR=/app/data \
    BGE_DEVICE=cpu \
    BGE_FP16=false

# 默认启动文档导入服务；查询服务在 compose 中通过 command 覆盖
CMD ["uv", "run", "--frozen", "--no-sync", "python", "-m", "knowledge_base.web.api.import_service"]
