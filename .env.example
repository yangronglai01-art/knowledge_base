# Copy this file to .env and replace placeholder values before starting the app.
# Never commit the real .env file.

# ====================
# MinerU PDF parsing
# ====================
MINERU_API_TOKEN=your_mineru_api_token_here
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# OpenAI-compatible LLM service
# ====================
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1
VL_MODEL=qwen3-vl-flash
ITEM_MODEL=qwen-flash

# ====================
# MinIO object storage
# Values below match the local docker-compose development defaults.
# ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key
MINIO_BUCKET_NAME=knowledge-base
MINIO_IMG_DIR=upload-images

# ====================
# BGE-M3 embedding model
# Use a local model directory here if the model has already been downloaded.
# ====================
BGE_M3_PATH=BAAI/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=false

# ====================
# Milvus vector database
# ====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# ====================
# MongoDB conversation history
# ====================
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=kb_message

# ====================
# Langfuse observability
# Replace all placeholder secrets before starting Docker Compose.
# LANGFUSE_ENCRYPTION_KEY must be a 64-character hexadecimal string.
# ====================
LANGFUSE_POSTGRES_USER=postgres
LANGFUSE_POSTGRES_PASSWORD=replace_with_a_strong_database_password
LANGFUSE_POSTGRES_DB=postgres
LANGFUSE_NEXTAUTH_SECRET=replace_with_a_long_random_secret
LANGFUSE_SALT=replace_with_a_long_random_salt
LANGFUSE_ENCRYPTION_KEY=replace_with_64_hex_characters

# Langfuse SDK 接入配置（应用侧向 Langfuse 上报 trace 用）
# 在 Langfuse 控制台创建 Project 后在「API Keys」里生成 pk/sk，
# 填入下面两个变量。HOST 容器内会自动覆盖为 http://langfuse-server:3000，
# 本机调试时用 http://localhost:3000。
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ====================
# DashScope MCP web search
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ====================
# Reranker
# Uses OPENAI_API_KEY through the DashScope SDK.
# ====================
TEXT_RERANK_MODEL=qwen3-rerank
TEXT_RERANK_INSTRUCT="Retrieve semantically similar text."

# ====================
# Local document processing directory
# ====================
DATA_BASED_ROOT_DIR=./data

# ====================
# Document permission filtering
# ====================
# Master switch: set to false to disable permission filtering entirely (default: true).
PERMISSION_FILTER_ENABLED=true
# Default dept assigned to documents when none is provided during import ("*" = public to all).
DEFAULT_DOC_DEPT=*
# Default clearance level (1-5) assigned to documents when none is provided during import.
DEFAULT_DOC_CLEARANCE_LEVEL=1
